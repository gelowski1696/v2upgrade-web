# Public DNS name pointing to this VPS. Do not include https:// or a path.
DOMAIN=dashboard.example.com
ACME_EMAIL=admin@example.com

# Loopback-only ports consumed by the VPS's existing Nginx or Caddy reverse proxy.
# These avoid the existing services on 127.0.0.1:3100 and 127.0.0.1:3101.
WEB_HOST_PORT=3200
API_HOST_PORT=3201

# PostgreSQL. Generate a URL-safe password, then use the same value in DATABASE_URL.
POSTGRES_DB=posv2_subscription
POSTGRES_USER=posv2
POSTGRES_PASSWORD=REPLACE_WITH_OPENSSL_RAND_HEX_32
DATABASE_URL=postgresql://posv2:REPLACE_WITH_OPENSSL_RAND_HEX_32@postgres:5432/posv2_subscription?schema=public

# Generate every JWT secret independently with: openssl rand -hex 32
JWT_ACCESS_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
DEVICE_JWT_SECRET=CHANGE_ME
PORTAL_JWT_ACCESS_SECRET=CHANGE_ME

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
LICENSE_LEASE_DAYS=7
DEVICE_TOKEN_TTL=12h
PORTAL_ACCESS_TOKEN_TTL=15m
PORTAL_REFRESH_TOKEN_TTL_DAYS=30
PORTAL_PASSWORD_RESET_TTL_MINUTES=60

STORE_SNAPSHOT_MAX_BYTES=536870912
STORE_SNAPSHOT_RETAIN_PREVIOUS=2
STORE_SCHEMA_MIN_VERSION=27
STORE_SCHEMA_MAX_VERSION=27
STORE_CLIENT_CACHE_MAX=25
STORE_CLIENT_IDLE_MILLISECONDS=600000

PLATFORM_BACKUP_RETAIN_DAYS=30

# Keep false until the Resend values below are configured and the sender is verified.
PORTAL_SCHEDULED_REPORTS_ENABLED=false
RESEND_API_KEY=
RESEND_FROM_EMAIL="VMJAM Reports <reports@example.com>"
RESEND_WEBHOOK_SECRET=
