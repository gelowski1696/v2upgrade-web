{
    email {$ACME_EMAIL}
}

{$OWNER_DOMAIN} {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    @api path /api/*
    handle @api {
        reverse_proxy api:3100
    }

    handle {
        reverse_proxy web:80
    }

    log {
        output stdout
        format console
    }
}

{$ADMIN_DOMAIN} {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    @api path /api/*
    handle @api {
        reverse_proxy api:3100
    }

    handle {
        reverse_proxy subscription-web:8080
    }

    log {
        output stdout
        format console
    }
}
