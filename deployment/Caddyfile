{
    email {$ACME_EMAIL}
}

{$OWNER_DOMAIN} {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        Content-Security-Policy "default-src 'self'; base-uri 'self'; connect-src 'self'; font-src 'self' data:; form-action 'self'; frame-ancestors 'none'; img-src 'self' data:; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'"
        Cross-Origin-Opener-Policy "same-origin"
        Cross-Origin-Resource-Policy "same-origin"
        Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=(), usb=()"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        X-Robots-Tag "noindex, nofollow, noarchive"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    @api path /api/*
    handle @api {
        reverse_proxy api:3100 {
            header_down -Content-Security-Policy
            header_down -Cross-Origin-Opener-Policy
            header_down -Cross-Origin-Resource-Policy
            header_down -Permissions-Policy
            header_down -Referrer-Policy
            header_down -Server
            header_down -X-Content-Type-Options
            header_down -X-Frame-Options
            header_down -X-Robots-Tag
        }
    }

    handle {
        reverse_proxy web:80 {
            header_down -Content-Security-Policy
            header_down -Cross-Origin-Opener-Policy
            header_down -Cross-Origin-Resource-Policy
            header_down -Permissions-Policy
            header_down -Referrer-Policy
            header_down -Server
            header_down -X-Content-Type-Options
            header_down -X-Frame-Options
            header_down -X-Robots-Tag
        }
    }

    log {
        output stdout
        format console
    }
}

{$ADMIN_DOMAIN} {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        Content-Security-Policy "default-src 'self'; base-uri 'self'; connect-src 'self'; font-src 'self' data:; form-action 'self'; frame-ancestors 'none'; img-src 'self' data:; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'"
        Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=(), usb=()"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        X-Robots-Tag "noindex, nofollow, noarchive"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    @api path /api/*
    handle @api {
        reverse_proxy api:3100 {
            header_down -Content-Security-Policy
            header_down -Permissions-Policy
            header_down -Referrer-Policy
            header_down -Server
            header_down -X-Content-Type-Options
            header_down -X-Frame-Options
            header_down -X-Robots-Tag
        }
    }

    handle {
        reverse_proxy subscription-web:8080 {
            header_down -Content-Security-Policy
            header_down -Permissions-Policy
            header_down -Referrer-Policy
            header_down -Server
            header_down -X-Content-Type-Options
            header_down -X-Frame-Options
            header_down -X-Robots-Tag
        }
    }

    log {
        output stdout
        format console
    }
}
